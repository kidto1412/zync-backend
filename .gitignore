# ==========================================
# Backend (NestJS + Prisma + PM2) .gitignore
# ==========================================

# Dependencies
node_modules/

# Production & Build outputs
dist/
*.tsbuildinfo

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test & Coverage
coverage/
.nyc_output/

# OS & Editor files
.DS_Store
.idea/
.vscode/

# Ensure deployment and database configurations are tracked
!ecosystem.config.js
!prisma/schema.prisma
!prisma/migrations/
