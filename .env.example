# Template Environment configuration for Backend

DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

PORT=7001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

JWT_SECRET="replace_with_strong_256bit_secret"
SESSION_SECRET="replace_with_session_salt"

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

STUN_SERVER_URL="stun:stun.l.google.com:19302"
TURN_SERVER_URL="turn:turn.unibeam.app:3478"
TURN_USERNAME="unibeam_turn_user"
TURN_CREDENTIAL="unibeam_turn_pass"

# KaseraPay Gateway (QRIS & E-Wallet)
KASERAPAY_API_KEY="kp_live_xxxx"
KASERAPAY_BASE_URL="https://pay.kasera.id/v1"

MIDTRANS_SERVER_KEY="SB-Mid-server-xxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxx"
MIDTRANS_IS_PRODUCTION=false

LEMON_SQUEEZY_API_KEY="lemon_api_key_xxxx"
LEMON_SQUEEZY_STORE_ID="store_id"
LEMON_SQUEEZY_WEBHOOK_SECRET="webhook_secret"
